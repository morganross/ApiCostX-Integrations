{
  "name": "@apicostx/backend-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the APICostX backend API",
  "description": "TypeScript SDK for the APICostX user API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:syntax": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "5.9.3" },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": ["apicostx", "sdk", "api", "llm", "evaluation"]
}
